// Source for docs/img/dataflow.svg, which docs/dataflow.md embeds.
// Regenerate with: dot -Tsvg docs/img/dataflow.dot -o docs/img/dataflow.svg
//
// Deliberately ONE read's path only. The reference counting, the run a reader
// joins and the abort that does or does not cancel it are a second read's
// story, and dataflow.md tells it in prose — a diagram that draws two readers
// at once stops being the thing you look at first.
//
// SYNC: ~/src/gmod/bam-js/docs/img/dataflow.dot — same palette and legend.
// That one has wasm and worker-pool colors; there is neither here, so this
// legend is the three that apply.
digraph rangecache {
  rankdir=TB
  bgcolor="white"
  nodesep=0.3
  ranksep=0.36
  node [shape=box style="filled,rounded" fillcolor="#f6f8fa" color="#57606a"
        fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  read    [label="read(length, position, { signal })" fillcolor="#ddf4ff" color="#0969da"]
  guard   [label="signal.throwIfAborted()"]
  clamp   [label="clamp to known size" fillcolor="#fff8c5" color="#9a6700"]
  plan    [label="chunk grid: floor(pos / 256 KiB)"]
  hit     [label="chunk cache" fillcolor="#fff8c5" color="#9a6700"]
  join    [label="in-flight chunk" fillcolor="#fff8c5" color="#9a6700"]
  runs    [label="coalesce misses into runs"]
  limit   [label="limitConcurrency (20)" fillcolor="#fff8c5" color="#9a6700"]
  fetch   [label="one range request per run" fillcolor="#dafbe1" color="#1a7f37"]
  split   [label="slice run into chunks, cache each" fillcolor="#fff8c5" color="#9a6700"]
  after   [label="signal.throwIfAborted()"]
  asm     [label="assemble, truncate at EOF"]
  out     [label="Uint8Array" fillcolor="#ddf4ff" color="#0969da"]

  read -> guard
  guard -> clamp
  clamp -> plan
  plan -> hit
  hit -> asm [label=" hit "]
  hit -> join [label=" miss "]
  join -> asm [label=" join the run "]
  join -> runs [label=" miss "]
  runs -> limit [label=" ChunkRun[] "]
  limit -> fetch
  fetch -> split
  split -> asm
  asm -> after
  after -> out

  subgraph cluster_legend {
    label="Legend"
    labelloc="t"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    node [shape=box style="filled,rounded" fontsize=9 margin="0.1,0.04"]
    l1 [label="I/O" fillcolor="#dafbe1" color="#1a7f37"]
    l2 [label="cached / shared" fillcolor="#fff8c5" color="#9a6700"]
    l3 [label="caller's read" fillcolor="#ddf4ff" color="#0969da"]
    l1 -> l2 -> l3 [style=invis]
  }
}
