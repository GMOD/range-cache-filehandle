// Generated by scripts/diagrams/architecture.ts — do not edit.
// Every node is a function in src/, every edge is a call the source makes,
// and every number comes from src/constants.ts. Regenerate both this and
// its SVG with: pnpm diagrams
digraph architecture {
  rankdir=TB
  bgcolor="white"
  nodesep=0.3
  ranksep=0.36
  node [shape=box style="filled,rounded" fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  caller [label="a parser's read(length, position, { signal })" fillcolor="#ddf4ff" color="#0969da"]

  subgraph cluster_entry {
    label="the only part that knows what the source is"
    labelloc="t" fontname="Helvetica" fontsize=9 fontcolor="#57606a"
    color="#d0d7de" style="rounded" margin=9
    RemoteFileWithRangeCache_read [label="RemoteFileWithRangeCache.read\nkey = url" fillcolor="#f6f8fa" color="#57606a"]
    CachedFilehandle_read [label="CachedFilehandle.read\nkey = whatever names the bytes" fillcolor="#f6f8fa" color="#57606a"]
  }

  chunkCache_ts_getCachedRange [label="getCachedRange" fillcolor="#f6f8fa" color="#57606a"]
  chunkCache_ts_planRead [label="planRead\none pass over a 256 KiB grid" fillcolor="#f6f8fa" color="#57606a"]
  chunkCache_ts_getCached [label="getCached\na hit, moved to newest" fillcolor="#fff8c5" color="#9a6700"]
  chunkCache_ts_joinChunk [label="joinChunk\nanother read is fetching it" fillcolor="#fff8c5" color="#9a6700"]
  chunkCache_ts_fetchRun [label="fetchRun\none request per run of misses" fillcolor="#fff8c5" color="#9a6700"]
  chunkCache_ts_limitConcurrency [label="limitConcurrency\n≤ 20 in flight per origin" fillcolor="#fff8c5" color="#9a6700"]
  doFetch [label="doFetch\nwhatever the entry point passed" fillcolor="#f6f8fa" color="#57606a"]
  chunkCache_ts_publishChunk [label="publishChunk" fillcolor="#fff8c5" color="#9a6700"]
  chunkCache_ts_putCached [label="putCached\n1000 chunks, LRU, 15 min idle" fillcolor="#fff8c5" color="#9a6700"]
  chunkCache_ts_assembleRange [label="assembleRange" fillcolor="#f6f8fa" color="#57606a"]
  RemoteFileWithRangeCache_fetchRange [label="RemoteFileWithRangeCache.fetchRange" fillcolor="#dafbe1" color="#1a7f37"]
  inner_read [label="inner.read" fillcolor="#dafbe1" color="#1a7f37"]

  out [label="Uint8Array" fillcolor="#ddf4ff" color="#0969da"]

  caller -> RemoteFileWithRangeCache_read
  caller -> CachedFilehandle_read
  RemoteFileWithRangeCache_read -> chunkCache_ts_getCachedRange
  CachedFilehandle_read -> chunkCache_ts_getCachedRange
  chunkCache_ts_getCachedRange -> chunkCache_ts_planRead
  chunkCache_ts_getCachedRange -> chunkCache_ts_assembleRange
  chunkCache_ts_planRead -> chunkCache_ts_getCached
  chunkCache_ts_planRead -> chunkCache_ts_fetchRun
  chunkCache_ts_planRead -> chunkCache_ts_joinChunk
  chunkCache_ts_fetchRun -> chunkCache_ts_limitConcurrency
  chunkCache_ts_fetchRun -> chunkCache_ts_publishChunk
  chunkCache_ts_limitConcurrency -> doFetch
  doFetch -> inner_read
  doFetch -> RemoteFileWithRangeCache_fetchRange
  chunkCache_ts_publishChunk -> chunkCache_ts_putCached
  chunkCache_ts_assembleRange -> out
  chunkCache_ts_putCached -> chunkCache_ts_assembleRange [style=invis]

  subgraph cluster_legend {
    label="Legend"
    labelloc="t" fontname="Helvetica" fontsize=10 fontcolor="#57606a"
    color="#d0d7de" style="rounded" margin=9
    node [shape=box style="filled,rounded" fontsize=9 margin="0.1,0.04"]
    l1 [label="I/O" fillcolor="#dafbe1" color="#1a7f37"]
    l2 [label="cached / shared" fillcolor="#fff8c5" color="#9a6700"]
    l3 [label="caller's read" fillcolor="#ddf4ff" color="#0969da"]
    { rank=same; l1; l2; l3 }
    l1 -> l2 -> l3 [style=invis]
  }
  out -> l1 [style=invis]
}
