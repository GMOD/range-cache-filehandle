// Generated by scripts/diagrams/architecture.ts — do not edit.
// Every node is a function in src/, every edge is a call the source makes,
// and every number comes from src/constants.ts. Regenerate both this and
// its SVG with: pnpm diagrams
digraph architecture {
  rankdir=TB
  bgcolor="white"
  nodesep=0.3
  ranksep=0.36
  node [shape=box style="filled,rounded" fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  caller [label="a parser's read(length, position, { signal })" fillcolor="#ddf4ff" color="#0969da"]

  subgraph cluster_entry {
    label="the only part that knows what the source is"
    labelloc="t" fontname="Helvetica" fontsize=9 fontcolor="#57606a"
    color="#d0d7de" style="rounded" margin=9
    RemoteFileWithRangeCache_fetchBytes [label="RemoteFileWithRangeCache.fetchBytes\nkey = url" fillcolor="#f6f8fa" color="#57606a"]
    CachedFilehandle_read [label="CachedFilehandle.read\nkey = whatever names the bytes" fillcolor="#f6f8fa" color="#57606a"]
  }

  extentCache_ts_getCachedRange [label="getCachedRange" fillcolor="#f6f8fa" color="#57606a"]
  extentCache_ts_planNow [label="planNow\nno gaps: served at once" fillcolor="#f6f8fa" color="#57606a"]
  extentCache_ts_enqueue [label="enqueue\ngaps wait one microtask" fillcolor="#f6f8fa" color="#57606a"]
  extentCache_ts_flush [label="flush\nplans the turn: gaps grow to 64 KiB\nand merge within it" fillcolor="#f6f8fa" color="#57606a"]
  extentCache_ts_coverage [label="coverage\ncached extents, requests in flight" fillcolor="#fff8c5" color="#9a6700"]
  extentCache_ts_join [label="join\ncounted by the readers waiting" fillcolor="#fff8c5" color="#9a6700"]
  extentCache_ts_dispatch [label="dispatch\none request per cluster of gaps" fillcolor="#fff8c5" color="#9a6700"]
  extentCache_ts_limitConcurrency [label="limitConcurrency\n≤ 20 in flight per origin" fillcolor="#fff8c5" color="#9a6700"]
  doFetch [label="doFetch\nwhatever the entry point passed" fillcolor="#f6f8fa" color="#57606a"]
  extentCache_ts_insert [label="insert\n256 MiB LRU in ≤ 1 MiB pieces, 15 min idle" fillcolor="#fff8c5" color="#9a6700"]
  extentCache_ts_assemble [label="assemble" fillcolor="#f6f8fa" color="#57606a"]
  RemoteFileWithRangeCache_fetchRange [label="RemoteFileWithRangeCache.fetchRange" fillcolor="#dafbe1" color="#1a7f37"]
  inner_read [label="inner.read" fillcolor="#dafbe1" color="#1a7f37"]

  out [label="Uint8Array" fillcolor="#ddf4ff" color="#0969da"]

  caller -> RemoteFileWithRangeCache_fetchBytes
  caller -> CachedFilehandle_read
  RemoteFileWithRangeCache_fetchBytes -> extentCache_ts_getCachedRange
  CachedFilehandle_read -> extentCache_ts_getCachedRange
  extentCache_ts_getCachedRange -> extentCache_ts_planNow
  extentCache_ts_getCachedRange -> extentCache_ts_enqueue
  extentCache_ts_getCachedRange -> extentCache_ts_assemble
  extentCache_ts_planNow -> extentCache_ts_coverage
  extentCache_ts_planNow -> extentCache_ts_join
  extentCache_ts_enqueue -> extentCache_ts_flush
  extentCache_ts_flush -> extentCache_ts_coverage
  extentCache_ts_flush -> extentCache_ts_dispatch
  extentCache_ts_flush -> extentCache_ts_join
  extentCache_ts_dispatch -> extentCache_ts_limitConcurrency
  extentCache_ts_dispatch -> extentCache_ts_insert
  extentCache_ts_limitConcurrency -> doFetch
  doFetch -> inner_read
  doFetch -> RemoteFileWithRangeCache_fetchRange
  extentCache_ts_assemble -> out
  extentCache_ts_insert -> extentCache_ts_assemble [style=invis]

  subgraph cluster_legend {
    label="Legend"
    labelloc="t" fontname="Helvetica" fontsize=10 fontcolor="#57606a"
    color="#d0d7de" style="rounded" margin=9
    node [shape=box style="filled,rounded" fontsize=9 margin="0.1,0.04"]
    l1 [label="I/O" fillcolor="#dafbe1" color="#1a7f37"]
    l2 [label="cached / shared" fillcolor="#fff8c5" color="#9a6700"]
    l3 [label="caller's read" fillcolor="#ddf4ff" color="#0969da"]
    { rank=same; l1; l2; l3 }
    l1 -> l2 -> l3 [style=invis]
  }
  out -> l1 [style=invis]
}
